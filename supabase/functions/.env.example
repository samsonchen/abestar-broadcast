# Local values for the Edge Functions (`supabase start` reads supabase/functions/.env).
# Copy once: cp supabase/functions/.env.example supabase/functions/.env
# The hosted project gets its own values from `scripts/supabase-setup.sh --tts`.
TTS_FUNCTION_SECRET=local-tts-secret
ELEVENLABS_API_KEY=local-stub-key
ELEVENLABS_BASE_URL=http://kong:8000/functions/v1/elevenlabs-stub
